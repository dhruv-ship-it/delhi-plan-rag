# ZoneWise configuration. Copy to .env and edit. .env is never committed.
# Every variable here is optional except the API key: the default in app/config.py is
# used when a variable is unset or blank, and a value that will not parse falls back to
# that default rather than stopping the server (D-063, D-065).

# --- the model ---------------------------------------------------------------------
# The Anthropic API key. Without one the app runs in search-only mode: the map, the
# zone lookup, clause search and the clause reader all work, and /api/ask and
# /api/agent return 503 with the retrieved clauses in the body.
ANTHROPIC_API_KEY=your-key-here

# Which Anthropic model answers. Default: claude-haiku-5-5 (Anthropic's current Haiku
# API model id). Override to try a larger model without touching the code.
# LLM_MODEL=claude-haiku-5-5

# Force the scripted FakeLLM even when a real key is present. Useful for a demo that
# must not spend anything. Default: false.
# ZONEWISE_USE_FAKE_LLM=0

# --- the question verification screen ----------------------------------------------
# 1 enables the dev-only endpoints under /api/dev/eval/ and the Verify tab in the web
# app. Anything else, including unset, makes them 404. Never set this in production.
# Default: false.
# ZONEWISE_DEV=0

# --- abstention ---------------------------------------------------------------------
# Which score decides that retrieval was too weak to ask the model at all:
#   dense_cosine   top-1 dense cosine similarity (the default)
#   rerank_score   top-1 cross-encoder score, only meaningful when USE_RERANKER=1
# ABSTAIN_SIGNAL=dense_cosine

# The cut-off for that signal. PROVISIONAL (D-071): it is set so that it refuses none
# of the drafted answerable questions, which is the most conservative choice available
# before the questions are verified. The final value comes from the sweep in
# eval/run_eval.py against eval/questions_verified.jsonl.
# ABSTAIN_THRESHOLD=0.33

# Rerank the top 20 results with a cross-encoder after location-aware fusion. Off until
# the evaluation shows it helps (D-070). Costs about 0.4 s per query on a laptop CPU.
# USE_RERANKER=0

# --- limits and origins --------------------------------------------------------------
# Answering requests allowed per IP address per minute. Default: 10.
# RATE_LIMIT_PER_MINUTE=10

# Answering requests allowed for the whole service per day. This is the one that stands
# between a bug and an unbounded bill. Default: 300.
# RATE_LIMIT_PER_DAY=300

# Which browser origins may call the API, comma-separated. Default: the Vite dev server.
# In production set this to your own site and nothing else.
# CORS_ORIGINS=http://localhost:5173

# The longest question the API accepts, in characters. Default: 500.
# MAX_QUESTION_CHARS=500

# The largest request body the API accepts, in bytes. Default: 65536.
# MAX_REQUEST_BYTES=65536
