# secrets
.env

# python
.venv/
__pycache__/
*.pyc

# generated data (keep the folders, ignore the contents)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep

# DDA map layers: downloaded from gis.dda.org.in, which states no licence, so the
# layers themselves are never committed. data/layers/manifest.json is (see D-026).
data/layers/dda/*
!data/layers/dda/.gitkeep

# request logs: every question anyone asks this server (see D-052)
data/logs/*
!data/logs/.gitkeep

# frontend
web/node_modules/
web/dist/

# reference PDFs: maps used by hand, too big for git (LINKS.md is committed)
data/reference/*.pdf

# os
.DS_Store
